{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metyatech/fab-plugin-release-tools/raw/master/FabPortalSubmission.schema.json",
  "title": "Fab Portal Submission",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "pluginName",
    "productVersion",
    "listingId",
    "title",
    "productType",
    "category",
    "subcategory",
    "tags",
    "includedFormat",
    "engineVersions",
    "platforms",
    "license",
    "personalPriceUsd",
    "professionalPriceUsd",
    "matureContent",
    "generatedWithAi",
    "allowsUsageWithAi",
    "promotionalContent",
    "forumPost",
    "activation",
    "documentationUrl",
    "supportUrl",
    "technicalInformationFile",
    "media",
    "packages",
    "portalReady"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "pluginName": { "type": "string", "minLength": 1 },
    "productVersion": { "type": "string", "minLength": 1 },
    "listingId": { "$ref": "#/$defs/lowercaseUuid" },
    "title": { "type": "string", "minLength": 1 },
    "productType": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "$ref": "#/$defs/stringArray" },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "includedFormat": { "type": "string", "minLength": 1 },
    "engineVersions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "license": { "type": "string", "minLength": 1 },
    "personalPriceUsd": { "type": "number", "minimum": 0 },
    "professionalPriceUsd": { "type": "number", "minimum": 0 },
    "matureContent": { "type": "boolean" },
    "generatedWithAi": { "type": "boolean" },
    "allowsUsageWithAi": { "type": "boolean" },
    "promotionalContent": { "type": "boolean" },
    "forumPost": { "type": "boolean" },
    "activation": { "type": "string", "minLength": 1 },
    "documentationUrl": { "$ref": "#/$defs/httpsUrl" },
    "supportUrl": { "$ref": "#/$defs/httpsUrl" },
    "technicalInformationFile": { "$ref": "#/$defs/relativePath" },
    "media": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mediaItem" } },
    "packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packageItem" } },
    "portalReady": { "const": true }
  },
  "$defs": {
    "lowercaseUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$)).+$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mediaItem": {
      "type": "object",
      "required": ["order", "role", "bundleRelativePath", "sha256"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["thumbnail", "gallery"] },
        "bundleRelativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageItem": {
      "type": "object",
      "required": ["engineVersion", "bundleRelativePath", "sha256", "projectFileLink"],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "bundleRelativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "projectFileLink": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}

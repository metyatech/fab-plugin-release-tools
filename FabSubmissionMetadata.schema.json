{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metyatech/fab-plugin-release-tools/raw/master/FabSubmissionMetadata.schema.json",
  "title": "Fab Submission Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "technicalInformation"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "technicalInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "codeModules",
        "numberOfBlueprints",
        "numberOfCppClasses",
        "networkReplicated",
        "networkReplicationNotes",
        "supportedDevelopmentPlatforms",
        "supportedTargetBuildPlatforms",
        "dependencies",
        "prerequisites",
        "documentationUrl",
        "exampleProjectUrl",
        "exampleProjectNotes",
        "additionalNotes"
      ],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "codeModules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["Runtime", "Editor", "External"] },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "numberOfBlueprints": { "type": "integer", "minimum": 0 },
        "numberOfCppClasses": { "type": "integer", "minimum": 0 },
        "networkReplicated": { "type": "boolean" },
        "networkReplicationNotes": { "type": "string", "minLength": 1 },
        "supportedDevelopmentPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "supportedTargetBuildPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "exampleProjectUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://"
        },
        "exampleProjectNotes": { "type": "string", "minLength": 1 },
        "additionalNotes": { "type": "string", "minLength": 1 }
      }
    }
  }
}

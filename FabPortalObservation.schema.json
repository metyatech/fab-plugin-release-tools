{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metyatech/fab-plugin-release-tools/raw/master/FabPortalObservation.schema.json",
  "title": "Fab Portal Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "manifestSha256",
    "observedAtUtc",
    "listingId",
    "listingTitle",
    "listingStatus",
    "fields"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "enum": ["interactive-browser", "cdp"] },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "listingId": { "$ref": "#/$defs/lowercaseUuid" },
    "listingTitle": { "type": "string", "minLength": 1 },
    "listingStatus": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fieldObservation" }
    }
  },
  "$defs": {
    "lowercaseUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "fieldObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestJsonPath", "state", "view"],
      "properties": {
        "manifestJsonPath": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["OBSERVED", "NOT_VISIBLE", "NOT_DISCOVERED", "NOT_APPLICABLE"]
        },
        "value": { "$ref": "#/$defs/jsonValue" },
        "view": { "enum": ["listing", "format"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "manifestJsonPath": { "const": "descriptionLinks" } },
            "required": ["manifestJsonPath"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": { "$ref": "#/$defs/descriptionLink" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "manifestJsonPath": { "const": "faqs" } },
            "required": ["manifestJsonPath"]
          },
          "then": {
            "properties": {
              "value": { "type": "array", "items": { "$ref": "#/$defs/faq" } }
            }
          }
        },
        {
          "if": {
            "properties": { "manifestJsonPath": { "enum": ["descriptionRichText", "additionalInformationRichText"] } },
            "required": ["manifestJsonPath"]
          },
          "then": {
            "properties": {
              "value": { "$ref": "#/$defs/richText" }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "OBSERVED" } },
            "required": ["state"]
          },
          "then": { "required": ["value"] },
          "else": { "not": { "required": ["value"] } }
        }
      ]
    },
    "descriptionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "href"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "answer": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": { "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/richBlock" } } }
    },
    "richBlock": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "runs"], "properties": { "type": { "const": "paragraph" }, "runs": { "$ref": "#/$defs/richRuns" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "level", "runs"], "properties": { "type": { "const": "heading" }, "level": { "type": "integer", "minimum": 1, "maximum": 6 }, "runs": { "$ref": "#/$defs/richRuns" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "enum": ["unordered_list", "ordered_list"] }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/richRuns" } } } }
      ]
    },
    "richRuns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/richRun" } },
    "richRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1 }, "marks": { "type": "array", "uniqueItems": true, "items": { "enum": ["bold", "italic", "underline", "link"] } }, "href": { "type": "string", "format": "uri", "pattern": "^https://" } },
      "allOf": [
        { "if": { "properties": { "marks": { "contains": { "const": "link" } } }, "required": ["marks"] }, "then": { "required": ["href"] } },
        { "if": { "required": ["href"] }, "then": { "properties": { "marks": { "contains": { "const": "link" } } } } }
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metyatech/fab-plugin-release-tools/raw/master/FabMediaReview.schema.json",
  "title": "Fab Media Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "product", "version", "createdAtUtc", "media"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "reviewId": { "$ref": "#/definitions/lowercaseUuid" },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "createdAtUtc": { "type": "string", "minLength": 1 },
    "media": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/definitions/media" }
    }
  },
  "definitions": {
    "lowercaseUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$)).+$"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "role", "relativePath", "fileName", "width", "height", "sizeBytes", "sha256", "reviewPath"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["thumbnail", "gallery"] },
        "relativePath": { "$ref": "#/definitions/relativePath" },
        "fileName": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1920 },
        "height": { "type": "integer", "minimum": 1080 },
        "sizeBytes": { "type": "integer", "minimum": 1, "exclusiveMaximum": 3000000 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "reviewPath": { "$ref": "#/definitions/relativePath" }
      }
    }
  }
}

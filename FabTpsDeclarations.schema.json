{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metyatech/fab-plugin-release-tools/raw/master/FabTpsDeclarations.schema.json",
  "title": "Fab Third-Party Software Declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "declarations"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/declaration" }
    }
  },
  "definitions": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_name",
        "version",
        "vendor",
        "homepage_url",
        "source_repository_url",
        "source_tag",
        "source_commit",
        "license",
        "license_url",
        "bundled",
        "linkage",
        "platforms",
        "upstream_source_modified",
        "sends_data_to_creator",
        "distributed_notice_file",
        "purpose",
        "why_required",
        "additional_information"
      ],
      "properties": {
        "software_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "homepage_url": { "$ref": "#/definitions/httpsUrl" },
        "source_repository_url": { "$ref": "#/definitions/httpsUrl" },
        "source_tag": { "type": "string", "minLength": 1 },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "$ref": "#/definitions/httpsUrl" },
        "bundled": { "type": "boolean" },
        "linkage": { "type": "string", "enum": ["static", "dynamic"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "upstream_source_modified": { "type": "boolean" },
        "sends_data_to_creator": { "type": "boolean" },
        "distributed_notice_file": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "why_required": { "type": "string", "minLength": 1 },
        "additional_information": { "type": "string", "minLength": 1 }
      }
    }
  }
}
